# Environment files
.env
.env.local
*.secret

# Local-only configs — created from the matching *.example by install.sh.
# These contain real hostnames/IPs/usernames and must never be committed.
ssh/.ssh/config

# Everything else under ssh/.ssh/ is local-only too: private keys, the matching
# public keys, authorized_keys, and known_hosts (which records real hostnames
# and IPs). This repo is PUBLIC — only the *.example templates may be tracked.
ssh/.ssh/*
!ssh/.ssh/*.example

# gh CLI auth (hosts.yml stores an OAuth token in cleartext)
.gh-config/

# pi (pi.dev) — only hand-written config is tracked. Everything below is either a
# credential store, work content, or upstream code that pi re-fetches on its own.
# stow's --no-folding keeps ~/.pi/agent a real directory, so pi writes these to
# $HOME and they never reach the repo. That is not a guarantee: stow reads
# .stowrc from the CURRENT directory (man stow, RESOURCE FILES), so --no-folding
# applies only when stow is run from this repo's root. `stow -d ~/.dotfiles -t ~
# pi` from anywhere else silently folds ~/.pi into one symlink into the checkout,
# and pi then writes straight into it. This block is what stands between that and
# a push. This repo is PUBLIC.
pi/.pi/agent/auth.json
pi/.pi/agent/sessions/
pi/.pi/agent/npm/
pi/.pi/agent/bin/
# Parked permission-gate escalations. The gate writes these 0600 precisely
# because a recorded command can carry a credential in its arguments.
pi/.pi/agent/gate-requests/
# What an unattended agent is allowed to do on this host: security posture, and
# it may carry the judge's shared secret. $PI_GATE_POLICY can point elsewhere.
pi/.pi/agent/extensions/gate-policy.json
# Provider request/response logs — work content, same reason as sessions/. The
# files happen to end in .log and are caught by the generic rule below; the
# directory is not, so anything else dropped in here would be exposed.
pi/.pi/agent/cc-cli-logs/
pi/.pi/agent/models-store.json
# Vendored copy of pi's own example sandbox extension (upstream code + its own
# node_modules). sandbox.json — the allowlist, which is ours — is tracked.
pi/.pi/agent/extensions/sandbox/

# AUR checkouts / package build trees. install.sh and the container build clone
# these; they are upstream sources + build output, not dotfiles, and they carry
# their own nested .git (which would land here as a broken gitlink). yay/ alone
# reached ~1GB of artifacts.
/yay/
/1password/

# Build artifacts and runtime state (any location)
*.o
*.hi
*.errors
xmonad-x86_64-linux
prompt-history

# Test and log files
*.cast
*.log
